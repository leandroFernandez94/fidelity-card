{
  "name": "fidelity-card",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"cd frontend && bun run dev\" \"cd backend && bun run dev\"",
    "build": "cd frontend && bun run build",
    "lint": "eslint .",
    "preview": "cd frontend && bun run preview",
    "api:dev": "cd backend && bun run dev",
    "api:start": "cd backend && bun run start",
    "db:generate": "cd backend && bun run db:generate",
    "db:migrate": "cd backend && bun run db:migrate",
    "db:reset": "cd backend && bun run db:reset",
    "db:smoke": "cd backend && bun run db:smoke",
    "bootstrap:admin": "cd backend && bun run bootstrap:admin",
    "seed:dev": "cd backend && bun run seed:dev",
    "seed:test": "cd backend && bun run seed:test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test --ui -c e2e/playwright.config.ts",
    "e2e:headed": "playwright test --headed -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^9.0.0"
  }
}
