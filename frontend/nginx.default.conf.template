# Bloque principal: solo el dominio de produccion (ALLOWED_HOST, inyectado como
# env en runtime; no se hardcodea porque el repo es publico).
server {
    listen ${PORT};
    server_name ${ALLOWED_HOST};

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # El HTML es el unico archivo que cambia de contenido manteniendo el nombre:
    # sin no-cache, el navegador puede servir una version vieja tras un deploy.
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

# Hostname de la plataforma: SOLO el healthcheck (Fly lo usa para marcar la
# machine healthy). Todo lo demas responde 421 para que nadie bypasee el proxy
# de Cloudflare pegando directo al hostname de Fly.
server {
    listen ${PORT};
    server_name fidelity-card-frontend.fly.dev;

    location = /api/health {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 421;
    }
}

# Cualquier otro Host (scanners, acceso directo por IP): rechazado.
# Excepcion: /api/health responde siempre — el healthcheck de Fly llega con un
# Host interno (no el hostname de la app), y es un JSON inofensivo.
server {
    listen ${PORT} default_server;
    server_name _;

    location = /api/health {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 421;
    }
}
