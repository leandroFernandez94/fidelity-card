{
  "name": "@fidelity-card/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=.env --watch src/index.ts",
    "start": "NODE_ENV=production bun --env-file=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun scripts/reset-db.mjs",
    "bootstrap:admin": "bun scripts/bootstrap-admin.mjs",
    "seed:test": "bun scripts/seed-test.mjs",
    "seed:dev": "ADMIN_EMAIL=${ADMIN_EMAIL:-admin@test.com} ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin123} bun scripts/bootstrap-admin.mjs && bun run seed:test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.3.0",
    "@fidelity-card/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bun-types": "^1.2.22",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.3.8",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "vitest": "^4.0.18"
  }
}
